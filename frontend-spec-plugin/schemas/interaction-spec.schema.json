{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interaction-spec.schema.json",
  "title": "Frontend interaction specification",
  "type": "object",
  "required": ["schema_version", "revision", "review_status", "approval", "interactions", "unmapped_requirements", "conflicts"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "revision": { "type": "integer", "minimum": 1 },
    "review_status": { "enum": ["pending_review", "changes_requested", "approved"] },
    "approval": {
      "type": ["object", "null"],
      "required": ["decision_id", "revision", "approved_by", "approved_at"],
      "additionalProperties": false,
      "properties": {
        "decision_id": { "type": "string", "pattern": "^DEC-[0-9]{3,}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement_ids", "element_ids", "event", "actions", "states", "success", "errors"],
        "properties": {
          "id": { "pattern": "^IX-[0-9]{3,}$" },
          "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "element_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "api_ids": { "type": "array", "items": { "type": "string" } },
          "event": { "type": "string" },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "validation": { "type": "array", "items": { "type": "string" } },
          "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "states": { "type": "array", "items": { "type": "string" } },
          "success": { "type": "array", "items": { "type": "string" } },
          "errors": { "type": "array", "items": { "type": "object" } },
          "recovery": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "unmapped_requirements": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "object" } }
  }
}
